# ~/.config/imgwatch/config  (sourced by bash; install.sh writes it on first install)
# Interpreter for imgwatch and its hooks. Needs: stdlib; `iterm2` for the browser lane;
# `selenium` + Chrome for the headless-screenshot lane.
IMGWATCH_PYTHON=/opt/anaconda3/bin/python
# iTerm2 Browser-type profile used for HTML. "" = no browser pane (falls back to shot, then link).
IMGWATCH_BROWSER_PROFILE=imgbrowser
# imgwatch pane width: percent of the tab (33) or columns (60c)
IMGPANE_WIDTH=33
# Pages served by a local web server (dashboards that fetch("/api/...")) look empty as files.
# Map a file or folder to the URL that serves it and the pane shows the live page instead.
# "PATH=URL" entries separated by ';'. A folder maps every page under it.
#IMGWATCH_URLMAP="~/my-dashboard/index.html=http://127.0.0.1:8080/;~/site=http://127.0.0.1:8000/"
