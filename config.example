# ~/.config/imgwatch/config  (sourced by bash; install.sh writes it on first install)
# Interpreter for imgwatch and both hooks. Needs: stdlib; `iterm2` for the browser lane;
# `selenium` + Chrome for the headless-screenshot lane.
IMGWATCH_PYTHON=/opt/anaconda3/bin/python
# iTerm2 Browser-type profile used for HTML. "" = no browser pane (falls back to shot, then link).
IMGWATCH_BROWSER_PROFILE=imgbrowser
# imgwatch pane width: percent of the tab (33) or columns (60c)
IMGPANE_WIDTH=33
